<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>{% block title %}Tickets{% endblock %}</title>

    {% block stylesheets %}
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    {% endblock %}
</head>

<body class="container">
    <header class="bg-body-tertiary">
        <h1 class="text-center">DECLARATION DES INCIDENTS</h1>
        <nav class="navbar">
            {% if app.session.get('role') %}
                <a class="btn btn-outline-primary" href="/logout" role="button">Se déconnecter</a>
                {% else %}
                <a class="btn btn-outline-primary" href="/login" role="button">Se connecter</a>
            {% endif %}
            
            
        </nav>
    </header>

     <main class="py-5">
        <div>
            {% block menu %}{% endblock %}
        </div>
        <div>
            {% block body %}{% endblock %}
        </<div>
    </main>

    <footer class="bg-dark text-white text-center py-4 mt-auto">
        <div>
            <p class="mb-0">© {{ "now"|date("Y") }} — Enregistrement de tickets.</p>
        </div>
    </footer>


    {% block javascripts %}
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    {% endblock %}
</body>
</html>

